  "historical_checks": [
    {
      "id": "historical-cache-state",
      "argv": [
        "python",
        "mp386/tools/test-cache-state.py"
      ],
      "inputs": [
        "mp386/build/oem-cache",
        "mp386/build/cache-state-recovery",
        "mp386/build/cmos-cache"
      ],
      "reason": "Frozen bench utility tied to superseded checksum/cache-qualification ROMs. Current firmware removed the CMOS cache qualifier; preserve original test and inputs without repinning."
    },
    {
      "id": "historical-shadow-alias",
      "argv": [
        "python",
        "mp386/tools/test-shadow-alias.py"
      ],
      "inputs": [
        "mp386/build/oem-cache",
        "mp386/build/cache-state-recovery",
        "mp386/build/cmos-cache",
        "mp386/build/zero-base"
      ],
      "reason": "Frozen upper-memory-recovery probes. The user retired recovery of the last2MiB and accepted the OEM memory boundary; current firmware does not claim this historical configuration."
    },
    {
      "id": "port-retained",
      "argv": [
        "python",
        "mp386/tools/test-port.py",
        "--image",
        "mp386/build/baios-mp386.bin",
        "--case",
        "retained"
      ],
      "reason": "Frozen a8d0542 whole-ROM equivalence reverses only the former Auto CHS repair. Current shared adoption intentionally changes emitted generic code; retain the original pins and classify this source-only comparison as historical."
    }
  ],
  "candidates": [
    {
      "id": "candidate",
      "argv": [
        "python",
        "mp386/tools/build.py",
        "--output",
        "build/pipeline-candidate"
      ]
    }
  ],
  "artifacts": [
    {
      "path": "mp386/build/pipeline-candidate/baios-mp386.bin",
      "name": "baios-mp386.bin",
      "size": 65536,
      "physical": true
    },
    {
      "path": "mp386/build/pipeline-candidate/baios-mp386-even.bin",
      "name": "baios-mp386-even.bin",
      "size": 32768,
      "physical": true
    },
    {
      "path": "mp386/build/pipeline-candidate/baios-mp386-odd.bin",
      "name": "baios-mp386-odd.bin",
      "size": 32768,
      "physical": true
    }
  ],
  "coverage_notes": [
    "Every current firmware case and reproducible read-only ROM-window utility check is active. The two retired bench probes and the frozen a8d0542 whole-ROM equivalence case remain explicit historical checks. --historical attempts their original conditions without repinning."
  ],
  "wrapped_tests": {
    "mp386/tools/test-cache-lifecycle.py": [
      "cache-lifecycle"
    ],
    "mp386/tools/test-cache.py": [
      "cache-lifecycle"
    ]
  }
