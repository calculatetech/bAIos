  "case_sets": [
    {
      "script": "mp386/tools/test-port.py",
      "argument": "--case",
      "exclude": [
        "retained"
      ]
    },
    {
      "script": "mp386/tools/test-memory.py",
      "argument": "--case"
    },
    {
      "script": "mp386/tools/test-cache.py",
      "argument": "--case",
      "covered_by": {
        "boot": "cache-lifecycle",
        "qualification": "cache-lifecycle",
        "instructions": "cache-lifecycle",
        "policy": "cache-lifecycle",
        "guards": "cache-lifecycle",
        "checksum": "cache-lifecycle"
      }
    },
    {
      "script": "mp386/tools/test-shadow.py",
      "argument": "--case"
    },
    {
      "script": "shared/tests/test-pnp.py",
      "argument": "--case",
      "exclude": [
        "all",
        "abi",
        "information-services",
        "nodes",
        "set-node",
        "image-contract",
        "isolation",
        "resource-reopen",
        "logical-devices",
        "memory-and-streams",
        "resource-semantics",
        "dependent-alternatives",
        "composed-resources",
        "option-roms",
        "boot-continuation",
        "placement"
      ],
      "covered_by": {
        "mp-negative": "pnp-exclusion"
      }
    },
    {
      "script": "shared/tests/test-ui-text.py",
      "argument": "--case",
      "covered_by": {
        "strings": "shared-ui-text",
        "renderer": "shared-ui-text",
        "setup": "shared-ui-text",
        "compatibility": "shared-ui-text",
        "image-contract": "shared-ui-text"
      }
    }
