{
  "schema": 1,
  "hold": "Selected 512 KB WB hardware passes Memtest and Quake. Remaining features and wider compatibility are deferred; routine updates require explicit inclusion.",
  "resources": [
    "reference",
    "tools/86box/source",
    "tools/86box/roms",
    "tools/deps",
    "m919/reference",
    "reference/media/dos/test-card.vhd"
  ],
  "prepare": [
    {
      "id": "build",
      "argv": [
        "powershell",
        "-NoProfile",
        "-File",
        "m919/tools/build.ps1"
      ]
    }
  ],
  "checks": [
    {
      "id": "attainable-tuning",
      "argv": [
        "python",
        "-B",
        "m919/tools/tuning_proof.py",
        "--image",
        "m919/build/baios-m919.bin",
        "--case",
        "game-port",
        "--case",
        "ecp-dma",
        "--case",
        "parity-controls",
        "--case",
        "parity-fast-boot",
        "--case",
        "t4-policy",
        "--case",
        "choices",
        "--case",
        "final-state",
        "--case",
        "host-cache"
      ]
    },
    {
      "id": "sio-tuning",
      "argv": [
        "python",
        "-B",
        "m919/tools/sio_proof.py",
        "--image",
        "m919/build/baios-m919.bin"
      ]
    },
    {
      "id": "pio-tuning",
      "argv": [
        "python",
        "-B",
        "m919/tools/pio_proof.py",
        "m919/build/baios-m919.bin",
        "--port",
        "m919",
        "--output",
        "m919/build/tests/pipeline-pio/proof.json"
      ]
    },
    {
      "id": "ide-completeness",
      "argv": [
        "python",
        "-B",
        "m919/tools/ide_completeness_proof.py",
        "m919/build/baios-m919.bin"
      ]
    },
    {
      "id": "shared-defaults",
      "argv": [
        "python",
        "-B",
        "shared/tools/checkpoint_proof.py",
        "m919/build/baios-m919.bin"
      ]
    },
    {
      "id": "ata-completion",
      "argv": [
        "python",
        "-B",
        "shared/tools/ata_completion_proof.py",
        "m919/build/baios-m919.bin"
      ]
    },
    {
      "id": "manual-adapters",
      "argv": [
        "python",
        "-B",
        "m919/tools/manual_proof.py"
      ]
    },
    {
      "id": "reset-video",
      "argv": [
        "python",
        "-B",
        "m919/tools/test-vga-reset.py",
        "m919/build/baios-m919.bin"
      ]
    },
    {
      "id": "rom-integrity",
      "argv": [
        "python",
        "-B",
        "tools/verify-rom.py",
        "m919",
        "--image",
        "build/baios-m919.bin"
      ]
    },
    {
      "id": "shared-dma-cascade",
      "argv": [
        "python",
        "-B",
        "shared/tools/dma_cascade_proof.py",
        "m919/build/baios-m919.bin",
        "--output",
        "m919/build/tests/pipeline-dma-cascade/proof.json"
      ]
    },
    {
      "id": "setup-ownership",
      "argv": [
        "python",
        "-B",
        "m919/tools/tuning_proof.py",
        "--image",
        "m919/build/baios-m919.bin",
        "--case",
        "setup-owners",
        "--case",
        "device-bounds",
        "--case",
        "device-commit",
        "--case",
        "ide-labels",
        "--output",
        "m919/build/tests/pipeline-setup-ownership/proof.json"
      ]
    },
    {
      "id": "reset-protected",
      "argv": [
        "python",
        "-B",
        "m919/tools/test-vga-reset.py",
        "m919/build/baios-m919.bin",
        "--warm-mode"
      ]
    }
  ],
  "case_sets": [],
  "historical_checks": [],
  "candidates": [
    {
      "id": "candidate",
      "argv": [
        "powershell",
        "-NoProfile",
        "-File",
        "m919/tools/build.ps1",
        "-OutputDirectory",
        "build/pipeline-candidate"
      ]
    }
  ],
  "artifacts": [
    {
      "path": "m919/build/pipeline-candidate/baios-m919.bin",
      "name": "baios-m919.bin",
      "size": 131072,
      "physical": true
    }
  ],
  "coverage_notes": [
    "The held-port checkpoint runs the explicit shared-defaults, ATA-completion, replacement-adapter and ROM-integrity checks above.",
    "Legacy POST/profile/certificate dispatchers remain historical tools, not evidence for the replacement adapter. Wider feature validation must be reconciled before this port joins routine updates."
  ],
  "wrapped_tests": {}
}
