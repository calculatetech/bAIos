        "dependent-alternatives": "shared-pnp",
        "composed-resources": "shared-pnp",
        "option-roms": "shared-pnp",
        "boot-continuation": "shared-pnp",
        "placement": "shared-pnp"
      }
    },
    {
      "script": "shared/tests/test-ui-text.py",
      "argument": "--case",
      "covered_by": {
