        "m919/build/baios-m919.bin",
        "--case",
        "game-port",
        "--case",
        "ecp-dma",
        "--case",
        "parity-controls",
        "--case",
        "parity-fast-boot",
        "--case",
        "t4-policy",
        "--case",
        "choices",
        "--case",
        "final-state",
        "--case",
        "host-cache"
