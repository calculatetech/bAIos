  "case_sets": [
    {
      "script": "shared/tests/test-pnp.py",
      "argument": "--case",
      "exclude": [
        "mp-negative"
      ],
      "covered_by": {
        "all": "shared-pnp",
        "abi": "shared-pnp",
        "information-services": "shared-pnp",
        "nodes": "shared-pnp",
        "set-node": "shared-pnp",
        "image-contract": "shared-pnp",
        "isolation": "shared-pnp",
        "resource-reopen": "shared-pnp",
