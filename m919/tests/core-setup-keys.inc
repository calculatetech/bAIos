    ; Normal -> Compatibility -> Manual retains3 waits. Left selects2.
    db 0x50,0x50,0x50,0x50,28,28,0x50,0x50,0x4D,0x4D,0x50,0x4B
    ; Back to Ports: COM1=3E8, COM2=2E8, LPT1=278, EPP.
    db 1,1,0x48,28,0x4D,0x50,0x4D,0x50,0x4D,0x50,0x4D
    ; Drives: A=720K. First ATA record: CHS translation, block count1.
%ifdef EMULATOR_SETUP_AUX_POLICY
    ; Mode -> FDC; another Down cannot select unavailable Mouse; return Mode.
    db 0x50,0x50,0x48
%endif
    db 1,0x48,0x48,28,0x4B,0x50,0x50,28,0x50,0x50,0x4D,0x50,0x4D
    ; Boot: Halt On Errors=No Errors, then Save and actual restart.
    db 1,1,0x50,28,0x50,0x50,0x50,0x50,0x50,0x50,0x4B,0x44,28,0
setup_test_time_key equ 255
