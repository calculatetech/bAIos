%ifndef PNP_POST_STATE_INCLUDED
%define PNP_POST_STATE_INCLUDED
PNP_JOURNAL_CURSOR equ 0x320
PNP_JOURNAL_END equ 0x324
PNP_JOURNAL_ORIGINAL_KIB equ 0x328
PNP_JOURNAL_EXTERNAL_KIB equ 0x32A
PNP_JOURNAL_COUNT equ 0x32C
PNP_JOURNAL_FIRST equ 0x330
PNP_JOURNAL_FLAGS equ 0x334
PNP_MODULE_POINTER equ 0x338
PNP_JOURNAL_CONTROL_END equ PNP_MODULE_POINTER+4
PNP_JOURNAL_FLOOR equ 0x10000 ; Existing low stack/firmware/backup owners stay below.
times -(PNP_JOURNAL_CONTROL_END > 0x340) db 0
times -(PNP_JOURNAL_CONTROL_END > S_PACKET_BYTES+0x200) db 0
times -(U_PNP_SCREEN >= PNP_JOURNAL_CURSOR) db 0

%endif
